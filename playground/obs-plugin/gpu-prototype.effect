uniform float4x4 ViewProj;
uniform texture2d image;
sampler_state linearSampler { Filter = Linear; AddressU = Clamp; AddressV = Clamp; };
sampler_state pointSampler { Filter = Point; AddressU = Clamp; AddressV = Clamp; };
struct VertData { float4 pos : POSITION; float2 uv : TEXCOORD0; };
VertData VSDefault(VertData v) { v.pos = mul(float4(v.pos.xyz, 1.0), ViewProj); return v; }
float4 PSPixel(VertData v) : TARGET {
    float4 original = image.Sample(linearSampler, v.uv);
    if (image.Sample(pointSampler, v.uv).a < 0.5) return float4(original.rgb, 1.0);
    float3 sum = float3(0.0, 0.0, 0.0);
    for (int y = -4; y <= 4; y++) {
        for (int x = -4; x <= 4; x++) {
            sum += image.Sample(linearSampler, v.uv + float2(x * 8.5 / 1280.0, y * 8.5 / 720.0)).rgb;
        }
    }
    return float4(sum / 81.0, 1.0);
}
technique Draw { pass { vertex_shader = VSDefault(v); pixel_shader = PSPixel(v); } }
